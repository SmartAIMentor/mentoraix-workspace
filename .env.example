# ============================================================
# Mentoraix Workspace 统一环境变量
# 复制为 .env 后填入实际值：cp .env.example .env
# ============================================================

# === 通用 API Keys ===
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === mentoraixs (Next.js :3000) ===
# mentoraixs → publish-service 后端
MENTORAIX_API_BASE_URL=http://localhost:58888
MENTORAIX_PUBLISH_API_BASE_URL=http://localhost:58889
MENTORAIX_CREATOR_ID=kris
MENTORAIX_CANDIDATE_CREATOR_ID=kris
APP_NAME=mentoraixs

# AI Providers（mentoraixs AI 路由使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ORBITAI_API_KEY=
ORBITAI_BASE_URL=https://aiapi.orbitai.global/v1
ORBITAI_MODEL=gpt-5.4

# mentoraixs → 智能体（原 ClawCore 已下线，由 Hermes↔OpenViking Adapter 替代）
# ⚠️ 单一真相源：mentoraixs 只读 CLAWCORE_BASE_URL（经 env.clawcoreBaseUrl），
#    主对话框 (server/core/ai/provider.ts) 和 legacy /chat/[id] (app/api/chat/route.ts) 共用这一个。
#    不要再造 CLAWCORE_API_URL —— 历史上曾混入一份默认 :8090 的副本，导致连不上。
#    ClawCore 已 decommissioned；Adapter 在 :8003 提供 ClawCore 兼容的 /api/chat + /api/sessions 契约。
CLAWCORE_BASE_URL=http://localhost:8003
CLAWCORE_API_KEY=

# 认证与数据库（Mentoraixs 新增）
AUTH_SECRET=
DATABASE_URL=
DATABASE_PROVIDER=

# 发布相关
PUBLISH_DRY_RUN=true
POST_BRIDGE_API_KEY=
POST_BRIDGE_BASE_URL=https://api.post-bridge.com
POST_BRIDGE_VIDEO_COVER_TIMESTAMP_MS=3000
POST_BRIDGE_TIKTOK_DRAFT=false
POST_BRIDGE_TIKTOK_IS_AIGC=false
POST_BRIDGE_INSTAGRAM_IS_TRIAL_REEL=false

# === publish-service Backend (FastAPI :58888) ===
# Social media publishing via Bundle Social API
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_BASE_URL=https://api.bundle.social
BUNDLE_SOCIAL_PORTAL_REDIRECT_URL=http://localhost:3000/social/callback
APP_ENV=development
DATA_DIR=backend/data
UPLOAD_DIR=backend/data/uploads

# === RecSys / Creator Hotspot (FastAPI :8000) ===
# 使用上方的 GEMINI_API_KEY；TikHub 用于数据采集（见下方「数据采集」）

# === 智能体 (Hermes↔OpenViking Adapter :8003) ===
# ClawCore 已下线，Adapter 在 :8003 提供 ClawCore 兼容契约（/api/chat + /api/sessions）
# 这些变量由 agent-runtime-lab/hermes-clawcore-adapter/scripts/stack-up.sh 自动注入，
# 一般无需手动设置；列全供手动启动/调优时参考。
HERMES_BASE_URL=http://127.0.0.1:8002
HERMES_API_KEY=                # = Hermes 的 API_SERVER_KEY（在 ~/.hermes/.env）
ADAPTER_PORT=8003
OPENVIKING_ENDPOINT=http://127.0.0.1:1933
OV_ROOT_KEY=                   # 从 ov-server/root_key.txt 读取（stack-up.sh 自动）
OV_ACCOUNT=mentoraix
# 鉴权：DEV_MODE=true 仅本地调试（信 body.user_id）；生产设 false + JWT_SECRET
DEV_MODE=false
JWT_SECRET=                    # DEV_MODE=false 时必填
MOONSHOT_API_KEY=              # 原 ClawCore 使用，已下线，保留向后兼容

# === 数据采集 ===
TIKHUB_API_KEY=
TIKHUB_API_BASE_URL=

# === 可选代理 ===
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
